{
  "env": {
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1",
    "VERCEL_ANALYZE_BUILD_OUTPUT": "1"
  },
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "backend": {
      "framework": "node",
      "mount": "backend",
      "entrypoint": "backend/index.js"
    }
  }
}
